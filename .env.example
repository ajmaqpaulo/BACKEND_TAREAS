PUERTO=5000
NODE_ENV=development

# ─── BASE DE DATOS ─────────────────────────────────────
BD_SERVIDOR=localhost
BD_PUERTO=1433
BD_NOMBRE=BD_GESTION_TAREAS
BD_USUARIO=sa
BD_CONTRASENA=changeme
BD_ENCRIPTAR=false
BD_CONFIAR_CERTIFICADO=true

# ─── JWT (debe coincidir con MICROSERVICIO_AUTH) ───────
JWT_SECRETO=changeme_generate_with_openssl_rand_hex_32

# ─── MICROSERVICIO AUTH ────────────────────────────────
AUTH_SERVICE_URL=http://localhost:4000

# ─── HTTPS ─────────────────────────────────────────────
USAR_HTTPS=false
SSL_CERT=./certs/cert.pem
SSL_KEY=./certs/key.pem
